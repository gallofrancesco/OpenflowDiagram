{
  "name": "openflow-diagram",
  "productName": "OpenflowDiagram",
  "version": "1.0.0",
  "description": "Ambiente di programmazione con diagrammi di flusso, con traduzione in C, C++, Java e Python",
  "author": "Francesco Gallo",
  "license": "MIT",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-tests.mjs",
    "icon": "node build/make-icon.mjs",
    "guide": "node tools/screenshots.mjs && node tools/make-guide.mjs && electron tools/guide-pdf.cjs",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.openflowdiagram.editor",
    "productName": "OpenflowDiagram",
    "artifactName": "OpenflowDiagram-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "OpenflowDiagram Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenflowDiagram",
      "uninstallDisplayName": "OpenflowDiagram"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "OpenflowDiagram ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Francesco Gallo",
      "synopsis": "Programmare con i diagrammi di flusso",
      "desktop": {
        "entry": {
          "Name": "OpenflowDiagram",
          "Comment": "Programmare con i diagrammi di flusso"
        }
      }
    }
  }
}
