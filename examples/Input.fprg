<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Input"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18T21:17:59.511Z"/>
        <attribute name="created" value="2026-10-18T21:17:59.511Z"/>
        <attribute name="edited" value="2026-10-18T21:17:59.511Z"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nome" type="String" array="False" size=""/>
            <declare name="n, i, x, somma" type="Integer" array="False" size=""/>
            <declare name="ok" type="Boolean" array="False" size=""/>
            <output expression="&quot;Come ti chiami?&quot;" newline="True"/>
            <input variable="nome"/>
            <input variable="n"/>
            <assign variable="somma" expression="0"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <input variable="x"/>
                <assign variable="somma" expression="somma + x"/>
            </for>
            <input variable="ok"/>
            <output expression="&quot;Ciao &quot; &amp; nome &amp; &quot;, somma = &quot; &amp; somma" newline="True"/>
            <if expression="ok">
                <then>
                    <output expression="&quot;confermato&quot;" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
