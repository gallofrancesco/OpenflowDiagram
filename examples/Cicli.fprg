<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Cicli"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18T21:17:59.510Z"/>
        <attribute name="created" value="2026-10-18T21:17:59.510Z"/>
        <attribute name="edited" value="2026-10-18T21:17:59.510Z"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, passi" type="Integer" array="False" size=""/>
            <comment text="Congettura di Collatz"/>
            <assign variable="n" expression="27"/>
            <assign variable="passi" expression="0"/>
            <while expression="n != 1">
                <if expression="n % 2 == 0">
                    <then>
                        <assign variable="n" expression="Int(n / 2)"/>
                    </then>
                    <else>
                        <assign variable="n" expression="3 * n + 1"/>
                    </else>
                </if>
                <assign variable="passi" expression="passi + 1"/>
            </while>
            <output expression="&quot;Passi: &quot; &amp; passi" newline="True"/>
            <assign variable="n" expression="0"/>
            <do expression="n &lt; 3">
                <output expression="n * 10" newline="False"/>
                <output expression="&quot; &quot;" newline="False"/>
                <assign variable="n" expression="n + 1"/>
            </do>
            <output expression="&quot;&quot;" newline="True"/>
            <for variable="n" start="10" end="1" direction="dec" step="3">
                <output expression="n" newline="True"/>
            </for>
            <output expression="2 ^ 10" newline="True"/>
            <output expression="-7 % 3" newline="True"/>
            <output expression="not (3 &gt; 2) or false" newline="True"/>
            <output expression="Abs(-5) + Sgn(-9)" newline="True"/>
            <breakpoint expression="" always="True"/>
        </body>
    </function>
</flowgorithm>
