<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="File"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18T21:17:59.512Z"/>
        <attribute name="created" value="2026-10-18T21:17:59.512Z"/>
        <attribute name="edited" value="2026-10-18T21:17:59.512Z"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, x, tot" type="Integer" array="False" size=""/>
            <open expression="&quot;flusso_test_dati.txt&quot;" mode="write"/>
            <for variable="i" start="1" end="5" direction="inc" step="1">
                <write expression="i * i"/>
            </for>
            <close/>
            <open expression="&quot;flusso_test_dati.txt&quot;" mode="read"/>
            <assign variable="tot" expression="0"/>
            <while expression="not EOF()">
                <read variable="x"/>
                <assign variable="tot" expression="tot + x"/>
            </while>
            <close/>
            <output expression="&quot;Totale: &quot; &amp; tot" newline="True"/>
        </body>
    </function>
</flowgorithm>
