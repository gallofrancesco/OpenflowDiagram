<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ordinamento"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18T21:17:59.510Z"/>
        <attribute name="created" value="2026-10-18T21:17:59.510Z"/>
        <attribute name="edited" value="2026-10-18T21:17:59.510Z"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="v" type="Integer" array="True" size="6"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="v[0]" expression="42"/>
            <assign variable="v[1]" expression="7"/>
            <assign variable="v[2]" expression="19"/>
            <assign variable="v[3]" expression="-3"/>
            <assign variable="v[4]" expression="7"/>
            <assign variable="v[5]" expression="100"/>
            <call expression="Ordina(v)"/>
            <for variable="i" start="0" end="Size(v) - 1" direction="inc" step="1">
                <output expression="v[i]" newline="True"/>
            </for>
            <output expression="&quot;Somma = &quot; &amp; Somma(v)" newline="True"/>
        </body>
    </function>
    <function name="Ordina" type="None" variable="">
        <parameters>
            <parameter name="a" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="i, j, t" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="Size(a) - 2" direction="inc" step="1">
                <for variable="j" start="0" end="Size(a) - 2 - i" direction="inc" step="1">
                    <if expression="a[j] &gt; a[j + 1]">
                        <then>
                            <assign variable="t" expression="a[j]"/>
                            <assign variable="a[j]" expression="a[j + 1]"/>
                            <assign variable="a[j + 1]" expression="t"/>
                        </then>
                        <else/>
                    </if>
                </for>
            </for>
        </body>
    </function>
    <function name="Somma" type="Integer" variable="s">
        <parameters>
            <parameter name="a" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="s, i" type="Integer" array="False" size=""/>
            <assign variable="s" expression="0"/>
            <for variable="i" start="0" end="Size(a) - 1" direction="inc" step="1">
                <assign variable="s" expression="s + a[i]"/>
            </for>
        </body>
    </function>
</flowgorithm>
