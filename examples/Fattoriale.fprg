<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Fattoriale"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18T21:17:59.508Z"/>
        <attribute name="created" value="2026-10-18T21:17:59.507Z"/>
        <attribute name="edited" value="2026-10-18T21:17:59.508Z"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i" type="Integer" array="False" size=""/>
            <assign variable="n" expression="6"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <output expression="&quot;Fatt(&quot; &amp; i &amp; &quot;) = &quot; &amp; Fact(i)" newline="True"/>
            </for>
        </body>
    </function>
    <function name="Fact" type="Integer" variable="r">
        <parameters>
            <parameter name="k" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="r" type="Integer" array="False" size=""/>
            <if expression="k &lt;= 1">
                <then>
                    <assign variable="r" expression="1"/>
                </then>
                <else>
                    <assign variable="r" expression="k * Fact(k - 1)"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
